From: =?UTF-8?q?Sandro=20J=C3=A4ckel?= <sandro.jaeckel@gmail.com>
Date: Thu, 5 Mar 2026 02:41:23 +0100
Subject: [PATCH] Fix Python 3.14 compatibility

---
 tests/test_dt.py |  7 ++++++-
 tests/test_es.py |  7 ++++++-
 tests/test_et.py | 11 ++++++++---
 3 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/tests/test_dt.py b/tests/test_dt.py
index b5f1811..bd42609 100644
--- a/tests/test_dt.py
+++ b/tests/test_dt.py
@@ -48,7 +48,12 @@ def assertSensor(self, sensor_name, expected_value, expected_unit, data):
 
     @classmethod
     def setUpClass(cls):
-        cls.loop = asyncio.get_event_loop()
+        cls.loop = asyncio.new_event_loop()
+        asyncio.set_event_loop(cls.loop)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.loop.close()
 
 
